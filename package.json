{
  "name": "inference-learning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:content": "node --import tsx scripts/check-headings.ts",
    "docs:dev": "vuepress dev notes --host 127.0.0.1",
    "docs:build": "vuepress build notes",
    "docs:clean-dev": "vuepress dev notes --host 127.0.0.1 --clean-cache --clean-temp",
    "export:page": "node scripts/export-page.mjs",
    "export:smoke": "playwright test tests/export-page.spec.ts",
    "test": "node --import tsx --test tests/**/*.test.ts && node --test tests/**/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.app.json"
  },
  "engines": {
    "node": "^22.18.0"
  },
  "packageManager": "pnpm@11.19.0",
  "devDependencies": {
    "@mdit/plugin-katex-slim": "1.1.0",
    "@playwright/test": "1.62.1",
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.1",
    "@vuepress/bundler-vite": "2.0.0-rc.31",
    "@vuepress/helper": "2.0.0-rc.131",
    "@vuepress/plugin-active-header-links": "2.0.0-rc.131",
    "@vuepress/plugin-markdown-chart": "2.0.0-rc.132",
    "@vuepress/plugin-markdown-ext": "2.0.0-rc.132",
    "@vuepress/plugin-slimsearch": "2.0.0-rc.131",
    "@vuepress/theme-default": "2.0.0-rc.132",
    "acorn": "8.18.0",
    "acorn-walk": "8.3.5",
    "echarts": "6.1.0",
    "katex": "0.18.4",
    "markdown-it": "15.0.1",
    "mermaid": "11.17.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vue": "3.5.41",
    "vue-tsc": "3.3.11",
    "vuepress": "2.0.0-rc.31",
    "yaml": "2.9.0"
  }
}
